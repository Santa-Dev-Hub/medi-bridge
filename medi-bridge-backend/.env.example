MONGO_URI=mongodb://localhost:27017/medi-bridge-db
# Secret used to sign JWT tokens. Replace with a strong random string in production
JWT_SECRET=a strong secret
# Optional: port the server should listen on (defaults to 5000)
PORT=5000
# If you use OpenAI features, set your API key (optional)
#OPENAI_API_KEY=sk-...
# If you use Twilio features, set these (optional)
#TWILIO_ACCOUNT_SID=ACxxxx
#TWILIO_AUTH_TOKEN=your_auth_token
